    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
